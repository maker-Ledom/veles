  lines:
  - speaker: 1
    text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043E\u0442\u0435\u0446!"
  - speaker: 0
    text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0441\u044B\u043D! \u041D\u0443\u0436\u043D\u043E
