  m_Script: {fileID: 11500000, guid: 8f7166ab9e23fb0409b5c0df134e2e1b, type: 3}
  m_Name: NewDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: 1
    text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043C\u0443\u0436! \u041A\u0430\u043A
      \u0434\u0435\u043B\u0430? "
  - speaker: 0
    text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0436\u0435\u043D\u0430! \u0412\u0441\u0435
      \u0445\u043E\u0440\u043E\u0448\u043E. \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E
      \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440
      \u0441\u0438\u043B\u044B.\n"
  - speaker: 1
    text: "\u0414\u0430\u0432\u0430\u0439 \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u043C"
